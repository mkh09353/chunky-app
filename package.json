{
  "name": "chunky-app",
  "version": "0.3.22",
  "private": true,
  "type": "module",
  "description": "Chunky — a beautiful coding-agent chat desktop app (Electrobun + Base UI + Tailwind v4). Talks to the local Chunky server over HTTP+SSE.",
  "scripts": {
    "dev": "concurrently -k -n vite,electrobun -c magenta,cyan \"vite --port 5173 --strictPort\" \"electrobun dev\"",
    "dev:web": "vite --port 5173 --strictPort",
    "build:web": "bun run typecheck:all && vite build",
    "build": "bun run build:web && electrobun build --env=stable",
    "preview": "vite preview --port 5173 --strictPort",
    "icons": "python3 scripts/generate-brand-assets.py",
    "icons:check": "python3 scripts/generate-brand-assets.py --check",
    "test": "bun test src/bun src/mainview/lib",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "typecheck:all": "bun run typecheck && bun run typecheck:tsc"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@chunky/protocol": "file:../chunky/packages/protocol",
    "@ff-labs/fff-bun": "0.9.6",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electrobun": "^1.18.1",
    "lucide-react": "^0.564.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.4.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/bun": "latest",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript/native-preview": "latest",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
